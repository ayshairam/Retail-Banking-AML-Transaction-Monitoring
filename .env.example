# ============================================================
# Retail Banking & AML Transaction Monitoring System
# Environment Configuration Example
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file or real secrets.
# ============================================================

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local: mongodb://127.0.0.1:27017/cba_banking_aml
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/cba_banking_aml
MONGODB_URI=mongodb://127.0.0.1:27017/cba_banking_aml

# --- Auth ---
# Generate a strong random string, e.g.: openssl rand -hex 64
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=1h

# --- CORS / Client ---
CLIENT_URL=http://localhost:5173

# --- Rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# --- Logging ---
LOG_LEVEL=info
